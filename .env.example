# ===== MCP 服务端点（必需）=====
# xwteam/gemini2api 的 OpenAI 兼容地址，例如 http://your-server:5918/openai/v1
GEMINI_API_BASE_URL=http://your-server:5918/openai/v1
# gemini2api 的 API 调用密钥（sk- 开头）
GEMINI_API_KEY=sk-your-api-key

# ===== 凭据自动巡检（可选，不配则只当 MCP 用）=====
# 管理端地址：与 GEMINI_API_BASE_URL 同源（不带 /openai/v1）
GEMINI2API_MANAGE_TARGET=http://your-server:5918
# gemini2api 管理密钥（ADMIN_API_KEY）
GEMINI2API_ADMIN_KEY=your-admin-key

# SSH 隧道（巡检通过本机环回隧道访问管理端）
GEMINI2API_SSH_HOST=your-server
# GEMINI2API_SSH_PORT=22
# GEMINI2API_SSH_USER=root
# 密码与密钥二选一：
# GEMINI2API_SSH_PASSWORD=
# GEMINI2API_SSH_KEY=~/.ssh/id_ed25519
# 远端服务端口（默认 5918）：
# GEMINI2API_SERVICE_PORT=5918
